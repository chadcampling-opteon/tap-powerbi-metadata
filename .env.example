# Power BI configuration
# Copy this file to .env and fill in your actual values

# Required: Azure AD tenant that owns the Power BI service principal
TAP_POWERBI_METADATA_TENANT_ID=your_tenant_id_here

# Required: Application (client) ID of the service principal
TAP_POWERBI_METADATA_CLIENT_ID=your_client_id_here

# Required: Client secret for the service principal
TAP_POWERBI_METADATA_CLIENT_SECRET=your_client_secret_here

# Optional: The earliest record date to sync (ISO format)
TAP_POWERBI_METADATA_START_DATE=2023-01-01T00:00:00Z
